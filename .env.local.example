# ---------------------------------------------------------------------------
# STEP 1 — Copy this file to `.env.local` (same folder) and fill in the values.
#
#   cp .env.local.example .env.local
#
# Find both values in your Supabase dashboard:
#   Project  ->  Settings  ->  API
#     "Project URL"   =>  NEXT_PUBLIC_SUPABASE_URL
#     "anon public"   =>  NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# IMPORTANT: put these SAME two values in every child notes site as well.
# All five sites talk to one Supabase project, so there is only ever one
# user table and one session — no per-site database required.
#
# The anon key is safe to expose in the browser (that is what NEXT_PUBLIC_
# means). Never put the `service_role` key in a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Used to build the OAuth redirect target when the request origin
# cannot be trusted (e.g. behind a proxy). Leave unset for local dev.
# NEXT_PUBLIC_SITE_URL=https://your-hub.vercel.app
