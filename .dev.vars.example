# ---------------------------------------------------------------------------
# Wrangler local dev secrets — copy to .dev.vars and fill in the values.
#
#   cp .dev.vars.example .dev.vars
#
# .dev.vars is gitignored. These are the same values as in .env.local but
# in Wrangler format (used by `wrangler dev` and `wrangler pages dev`).
#
# For production Cloudflare deployments, set these via:
#   wrangler secret put NEXT_PUBLIC_SUPABASE_URL
#   wrangler secret put NEXT_PUBLIC_SUPABASE_ANON_KEY
#   wrangler secret put NEXT_PUBLIC_SITE_URL
# Or in the Cloudflare dashboard → Workers → your-worker → Settings → Variables
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — set to your production domain to fix OAuth redirects behind proxies.
# NEXT_PUBLIC_SITE_URL=https://notes4btechcse.pages.dev
